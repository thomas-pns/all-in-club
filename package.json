{
  "name": "all-in-club",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Poker Texas Hold'em No-Limit cartoon entre amis — All-In Club",
  "scripts": {
    "dev:serveur": "tsx watch serveur/index.ts",
    "dev:client": "vite",
    "build": "vite build && npm run build:serveur",
    "build:serveur": "esbuild serveur/index.ts serveur/admin.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outdir=dist",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "pixi.js": "^8.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.9",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "nodemailer": "^10.3.1",
    "web-push": "^3.6.7"
  }
}
